---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Projects | Hossein Salahi">
	<h1>Projects</h1>
	<p class="intro">A selection of my recent work in platform engineering and web development.</p>
	<div class="projects-grid">
		{
			projects.map((project) => (
				<div class="project-card">
					{project.data.heroImage && <img src={project.data.heroImage} alt="" class="project-image" />}
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					<div class="tags">
						{project.data.tags.map(tag => <span class="tag">{tag}</span>)}
					</div>
					<div class="links">
						{project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
						{project.data.link && <a href={project.data.link} target="_blank" rel="noopener noreferrer">Live Demo</a>}
					</div>
				</div>
			))
		}
	</div>
</Layout>

<style>
	.intro {
		margin-bottom: 2rem;
		color: var(--secondary);
		font-size: 1.1rem;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	.project-card {
		padding: 1.5rem;
		border: 1px solid var(--header-border);
		border-radius: 12px;
		background: var(--background);
		transition: transform 0.2s, border-color 0.2s;
	}
	.project-card:hover {
		transform: translateY(-4px);
		border-color: var(--accent);
	}
	.project-image {
		width: 100%;
		height: 150px;
		object-fit: cover;
		border-radius: 8px;
		margin-bottom: 1rem;
	}
	h3 {
		margin-top: 0;
		color: var(--accent);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0;
	}
	.tag {
		font-size: 0.8rem;
		padding: 0.2rem 0.6rem;
		background: var(--accent-light);
		color: var(--accent);
		border-radius: 4px;
		font-weight: 600;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	.links a {
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text);
		border-bottom: 1px solid var(--text);
	}
	.links a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
</style>
